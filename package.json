{
  "name": "easyfonts",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "EasyFonts — Font manager desktop locale",
  "author": "EasyFonts",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:web": "concurrently -k -n server,app \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "start:web": "node server/index.mjs",
    "dist": "npm run notices && npm run check:repo && npm run build && electron-builder --win portable --x64 && node scripts/distribution.mjs",
    "notices": "node scripts/notices.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "docs:screenshots": "electron electron/docs-screenshots.mjs",
    "test:desktop": "electron electron/smoke.mjs",
    "test": "node --test tests/core.test.mjs tests/api.test.mjs tests/native.test.mjs",
    "sample": "node scripts/sample.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "opentype.js": "^1.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^6.3.5"
  }
}
